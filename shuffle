function shuffleArray(array) {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
}

function shuffleQuestionsAndAnswers() {
    // Randomizza l'ordine delle domande
    const shuffledQuestions = shuffleArray(questions);
    
    // Per ogni domanda, randomizza le risposte e aggiorna l'indice corretto
    shuffledQuestions.forEach(question => {
        if (question.type !== "order") { // Non randomizzare domande di ordine
            const originalAnswers = [...question.answers];
            const originalCorrect = question.correct;
            const correctAnswer = originalAnswers[originalCorrect];
            
            // Randomizza le risposte
            const shuffledAnswers = shuffleArray(originalAnswers);
            
            // Trova la nuova posizione della risposta corretta
            const newCorrectIndex = shuffledAnswers.indexOf(correctAnswer);
            
            // Aggiorna la domanda
            question.answers = shuffledAnswers;
            question.correct = newCorrectIndex;
        }
    });
    
    return shuffledQuestions;
}

function initializeGameQuestions() {
    // Seleziona casualmente 30 domande dall'array completo
    const selectedQuestions = shuffleArray(questions).slice(0, 30);
    
