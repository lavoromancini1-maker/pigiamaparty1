function resumeBackgroundMusicAfterMedia() {
    if (!audio.audioActivated || !audio.musicEnabled) return;
    
    console.log('🔊 Riprendo musica dopo audio...');
    audio.gameMusic.volume = audio.originalVolume || 0.3;
}
