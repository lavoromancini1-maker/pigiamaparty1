function lowerBackgroundMusic() {
    if (!audio.audioActivated || !audio.musicEnabled) return;
    
    console.log('🔉 Abbasso musica di sottofondo al 2%...');
    
    // Salva il volume corrente
    audio.originalVolume = audio.gameMusic.volume;
    
    // Abbassa gradualmente il volume FINO AL 2% (molto basso)
    const fadeOut = setInterval(() => {
        if (audio.gameMusic.volume > 0.02) {
            audio.gameMusic.volume -= 0.05;
        } else {
            audio.gameMusic.volume = 0.02; // Volume MOLTO basso (2%)
            clearInterval(fadeOut);
            console.log('🔉 Musica abbassata al 2%');
        }
    }, 50);
}

function restoreBackgroundMusic() {
    if (!audio.audioActivated || !audio.musicEnabled) return;
    
    console.log('🔊 Ripristino musica di sottofondo...');
    
    // Ripristina gradualmente il volume originale
    const targetVolume = audio.originalVolume || 0.3;
    const fadeIn = setInterval(() => {
        if (audio.gameMusic.volume < targetVolume) {
            audio.gameMusic.volume += 0.05;
        } else {
            audio.gameMusic.volume = targetVolume;
            clearInterval(fadeIn);
            console.log('🔊 Musica ripristinata al volume normale (30%)');
        }
    }, 50);
}

function stopBackgroundMusicForMedia() {
    if (!audio.audioActivated || !audio.musicEnabled) return;
    
    console.log('🔇 Fermo COMPLETAMENTE musica per riproduzione AUDIO...');
    audio.gameMusic.volume = 0; // Volume ZERO per audio
