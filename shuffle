            elements.finalLeaderboard.innerHTML = '';
            sortedPlayers.forEach((player, index) => {
                const li = document.createElement('li');
                li.className = 'player-item';
                li.innerHTML = `
                    <span class="player-icon">${getMedalIcon(player.rank)}</span>
                    <span class="player-name">${player.name}</span>
                    <span style="font-weight: 700; color: var(--accent-gold); font-size: 1.3rem;">${player.score}p</span>
                `;
                elements.finalLeaderboard.appendChild(li);
            });
            
            // EFFETTI VISIVI PER LA VITTORIA
            setTimeout(() => {
                addVictoryEffects();
            }, 500);
        }

        function getMedalIcon(rank) {
            switch(rank) {
                case 1: return '🥇';
                case 2: return '🥈';
                case 3: return '🥉';
                default: return '⭐';
            }
        }

        // === MINI CLASSIFICA LIVE ===
function updateLiveLeaderboard() {
    if (Object.keys(playerScores).length === 0) return;
    
    const sortedPlayers = Object.entries(playerScores)
        .sort(([,a], [,b]) => b.total - a.total)
        .map(([name, data], index) => ({
            name,
            score: data.total,
            rank: index + 1
        }));
    
    const leaderboardList = document.getElementById('liveLeaderboardList');
    leaderboardList.innerHTML = '';
    
    sortedPlayers.forEach(player => {
        const li = document.createElement('li');
        li.className = 'live-leaderboard-item';
        li.innerHTML = `
            <span class="live-rank">${player.rank}°</span>
            <span class="live-player-name">${player.name}</span>
            <span class="live-player-score">${player.score}p</span>
        `;
        leaderboardList.appendChild(li);
    });
}

function toggleLiveLeaderboard() {
    const leaderboard = document.getElementById('liveLeaderboard');
    const toggleBtn = document.getElementById('leaderboardToggle');
    
    leaderboard.classList.toggle('hidden');
    
    if (leaderboard.classList.contains('hidden')) {
        toggleBtn.textContent = '📊';
        toggleBtn.title = 'Mostra classifica';
    } else {
        toggleBtn.textContent = '❌';
        toggleBtn.title = 'Nascondi classifica';
        updateLiveLeaderboard();
    }
}

        function endGame() {
            playerAnswers.forEach(answer => {
                if (answer.questionIndex !== undefined) {
                    const question = shuffledQuestions[answer.questionIndex];
                    if (question) {
                        const pointsData = calculatePoints(answer, question);
                        if (pointsData.points > 0) {
                            if (!playerScores[answer.playerName]) {
                                playerScores[answer.playerName] = { total: 0, correctAnswers: 0, speedBonuses: 0 };
                            }
                            playerScores[answer.playerName].total += pointsData.points;
                            playerScores[answer.playerName].correctAnswers += 1;
                            if (pointsData.speedBonus > 0) {
                                playerScores[answer.playerName].speedBonuses += pointsData.speedBonus;
                            }
                        }
                    }
                }
            });
            
            showLeaderboard();
        }

        // === EVENT LISTENERS ===
        elements.startBtn.addEventListener('click', function() {
            audio.playSFX('clickSound');
            startGame();
        });
        
        elements.nextBtn.addEventListener('click', function() {
            audio.playSFX('clickSound');
            nextQuestion();
        });

elements.skipTimerBtn.addEventListener('click', function() {
    audio.playSFX('clickSound');
    clearInterval(timer);
    showCorrectAnswer();
    elements.nextBtn.disabled = false;
    elements.nextBtn.innerHTML = '<span>➡️</span> NEXT QUESTION';
    elements.timer.textContent = "0"; // MOSTRA SEMPRE NUMERO
});

        elements.showAnswerBtn.addEventListener('click', function() {
            audio.playSFX('clickSound');
            showAnswerManually();
        });

        elements.restartBtn.addEventListener('click', function() {
            audio.playSFX('clickSound');
            location.reload();
        });

        // CONTROLLI TEMI
        document.querySelectorAll('.theme-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                audio.playSFX('clickSound');
                changeTheme(this.dataset.theme);
            });
        });

        document.getElementById('musicToggle').addEventListener('click', function() {
            audio.playSFX('clickSound');
            audio.toggleMusic();
        });
        
        document.getElementById('sfxToggle').addEventListener('click', function() {
            audio.toggleSFX();
        });

        document.getElementById('activateAudio').addEventListener('click', function() {
            console.log('🎵 Pulsante Attiva Audio cliccato');
            audio.activateAudio();
        });

        // Controllo classifica live
document.getElementById('leaderboardToggle').addEventListener('click', function() {
    audio.playSFX('clickSound');
    toggleLiveLeaderboard();
});

        // === AVVIA IL GIOCO ===
        initGame();
        
        setTimeout(() => {
            console.log('🔄 HOST Game Show Edition v2.0 attivo');
            document.title = "Pigiama Party - Game Master";
        }, 100);
    </script>
